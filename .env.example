# ─────────────────────────────────────────────────────────────────────────────
# Aspire LMS — environment template. Copy to `.env` (root) and/or set these in
# Vercel Project Settings → Environment Variables. NEVER commit the real `.env`.
#
#   cp .env.example .env
#
# VITE_* values are embedded in the browser bundle at build time → PUBLISHABLE
# (safe to expose): the Supabase anon key and Firebase web config are meant to be
# public. Everything WITHOUT the VITE_ prefix is a SERVER-ONLY SECRET used by the
# /api serverless functions and must never appear in the frontend bundle.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (frontend — publishable) ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Supabase (serverless /api — may reuse the same values) ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Firebase phone-auth (frontend — publishable web config) ──
# Leave blank to fall back to the on-screen demo OTP in local dev.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Email OTP (serverless /api — SECRETS) ──
# Gmail account + app password used by /api/send-otp to email the login code.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-gmail-app-password

# HMAC secret that signs/verifies the OTP token. REQUIRED — the OTP endpoints now
# fail closed if this is unset (no insecure default). Use a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=generate-a-long-random-string

# ── Aspire LMS Frontend Environment Variables ─────────────────────────────

# Backend API URL (Points to the standalone backend service)
# In development: http://localhost:5000
# In production: https://api.yourdomain.com (or leave empty if reverse-proxied at /api)
VITE_API_URL=http://localhost:5000

# Supabase Public Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Firebase Authentication / Storage Configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
